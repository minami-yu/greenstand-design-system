{
  "expo": {
    "name": "Greenstand Blue Sky",
    "slug": "greenstand-bluesky-prototype",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": ["ios", "android", "web"],
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Greenstand Blue Sky to use the camera for the capture prototype."
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
