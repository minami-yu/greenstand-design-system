{
  "name": "greenstand-design-system",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build-tokens": "npm run build-tokens -w @greenstand/design-system",
    "generate-icons": "npm run generate-icons -w @greenstand/design-system",
    "start": "npm run start -w @greenstand/bluesky-prototype",
    "storybook": "npm run storybook -w @greenstand/design-system",
    "storybook:web": "npm run storybook:web -w @greenstand/design-system",
    "storybook:web:build": "npm run storybook:web:build -w @greenstand/design-system",
    "prototype": "npm run start -w @greenstand/bluesky-prototype",
    "prototype:web": "npm run web -w @greenstand/bluesky-prototype",
    "prototype:web:build": "npm run web:build -w @greenstand/bluesky-prototype",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@mdi/js": "^7.4.47",
    "@react-native/assets-registry": "^0.88.0",
    "expo": "^58.0.0",
    "expo-font": "~58.0.10",
    "expo-modules-core": "~58.0.26",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "typescript": "~6.0.3"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/react-native": "^10.6.2",
    "@storybook/react-native-web-vite": "^10.6.2",
    "@types/react": "^19.1.1",
    "cross-env": "^7.0.3",
    "react-dom": "19.3.0",
    "react-native-web": "^0.21.2",
    "storybook": "^10.6.2",
    "style-dictionary": "^5.4.4",
    "vite": "^6.4.5"
  },
  "overrides": {
    "brace-expansion@^2.0.0": "^2.1.7",
    "qs": "^6.16.1"
  }
}
