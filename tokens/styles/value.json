{
  "elevation": {
    "sm": {
      "$type": "shadow",
      "$value": [
        {
          "color": "#0c0c0d14",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "4px",
          "spread": "0px"
        },
        {
          "color": "#0c0c0d1a",
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "1px",
          "spread": "0px"
        },
        {
          "color": "#0c0c0d0d",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "8px",
          "spread": "0px"
        }
      ]
    },
    "md": {
      "$type": "shadow",
      "$value": [
        {
          "color": "#0c0c0d14",
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "6px",
          "spread": "0px"
        },
        {
          "color": "#0c0c0d14",
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "4px",
          "spread": "0px"
        },
        {
          "color": "#0c0c0d0d",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "8px",
          "spread": "0px"
        }
      ]
    },
    "lg": {
      "$type": "shadow",
      "$value": [
        {
          "color": "#0c0c0d14",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "12px",
          "spread": "0px"
        },
        {
          "color": "#0c0c0d14",
          "offsetX": "0px",
          "offsetY": "8px",
          "blur": "16px",
          "spread": "0px"
        },
        {
          "color": "#0c0c0d0d",
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "6px",
          "spread": "0px"
        }
      ]
    }
  },
  "heading-m": {
    "$type": "typography",
    "$value": {
      "fontFamily": "{family.title}",
      "fontWeight": "{weight.bold}",
      "lineHeight": 1.3,
      "fontSize": "{size.heading-m}",
      "letterSpacing": "0px",
      "textCase": "none",
      "textDecoration": "none"
    },
    "$description": "Sheet title"
  },
  "heading-s": {
    "$type": "typography",
    "$value": {
      "fontFamily": "{family.title}",
      "fontWeight": "{weight.bold}",
      "lineHeight": 1.4,
      "fontSize": "{size.heading-s}",
      "letterSpacing": "0px",
      "textCase": "none",
      "textDecoration": "none"
    },
    "$description": "Section header, groups related content within a page."
  },
  "paragraph-l": {
    "$type": "typography",
