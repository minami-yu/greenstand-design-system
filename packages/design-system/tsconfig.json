{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "src/components/**/*.ts",
    "src/components/**/*.tsx",
    "src/theme/**/*.ts",
    "src/theme/**/*.tsx",
    "src/index.ts",
    "src/types/**/*.d.ts"
  ],
  "exclude": [
    "src/**/*.stories.tsx",
    "src/**/*.mdx",
    "src/storybook/**",
    "src/components/Spinner/SpinnerPlatformTable.tsx"
  ]
}
