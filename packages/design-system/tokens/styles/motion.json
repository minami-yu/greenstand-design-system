{
  "motion": {
    "$description": "Shared motion primitives and component-specific animation values.",
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": { "value": 150, "unit": "ms" }
      },
      "moderate": {
        "$type": "duration",
        "$value": { "value": 200, "unit": "ms" }
      },
      "slow": {
        "$type": "duration",
        "$value": { "value": 300, "unit": "ms" }
      }
    },
    "easing": {
      "decelerate": {
        "$type": "cubicBezier",
        "$value": [0, 0, 0.2, 1]
      }
    },
    "component": {
      "spinner": {
        "duration": {
          "$type": "duration",
          "$value": { "value": 1000, "unit": "ms" }
        },
        "easingAccelerate": {
          "$type": "cubicBezier",
          "$value": [0.42, 0.12, 0.8, 0.72]
        },
        "easingDecelerate": {
          "$type": "cubicBezier",
          "$value": [0.2, 0.28, 0.58, 0.88]
        }
      }
    }
  }
}
