{
  "name": "@greenstand/design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./theme": "./src/theme/index.ts"
  },
  "scripts": {
    "build-tokens": "node build.js",
    "generate-icons": "node scripts/generate-icon-registry.mjs",
    "start": "expo start",
    "storybook": "cross-env STORYBOOK_ENABLED=true expo start",
    "storybook:web": "storybook dev -p 6006 -c .storybook-web",
    "storybook:web:build": "storybook build -c .storybook-web -o storybook-static",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "expo": "^57.0.0",
    "expo-font": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4"
  }
}
